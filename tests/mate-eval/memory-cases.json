{
  "scope": "MODEL_MEMORY_POLICY_DECISIONS_NOT_DATABASE_OR_JOB_ACCEPTANCE",
  "actions": {
    "save": "可保存直接长期偏好",
    "candidate": "推断或敏感事实待确认",
    "task": "仅任务范围或时效信息",
    "ignore": "不作为用户长期记忆",
    "update": "用户纠正旧事实",
    "forget": "明确遗忘并净化引用",
    "scoped": "只用于匹配作用域",
    "clarify": "信息不足先澄清"
  },
  "cases": [
